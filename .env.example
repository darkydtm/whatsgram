# ==============================================================================
# Whatsgram Reference Configuration
# ==============================================================================
# This configuration file defines settings for the Whatsgram bidirectional
# bridge between WhatsApp and Telegram supergroups.
#
# Precedence:
# Environment variables (WHATSGRAM_*) override .env values, which override defaults.
#
# Security Notice:
# Never commit real tokens, chat IDs, phone numbers, or private credentials
# into version control. Keep this file as an annotated reference template.
# ==============================================================================

# ------------------------------------------------------------------------------
# Telegram Adapter Configuration
# ------------------------------------------------------------------------------
# Bot API authentication token obtained from @BotFather.
# Can be injected via WHATSGRAM_TELEGRAM_TOKEN environment variable.
# Must remain an empty string in this example file.
WHATSGRAM_TELEGRAM_TOKEN=""

# Target Telegram supergroup ID (must be a negative int64 with topics enabled).
# The bot must be added to this forum supergroup as an administrator with:
# - can_manage_topics
# - can_delete_messages
WHATSGRAM_TELEGRAM_CHAT_ID=-1001234567890

# Allowlist of authorized Telegram user IDs (positive int64 integers).
# Only users listed here can issue admin commands (/help, /status, /pair, /sync, etc.).
# The first numeric ID in this list is designated as the primary account driver
# for native reactions and poll voting.
# Format: comma-separated list of IDs.
WHATSGRAM_TELEGRAM_ALLOWED_USER_IDS="42"

# Telegram Bot API server endpoint.
# Default is official cloud API: https://api.telegram.org
WHATSGRAM_TELEGRAM_ENDPOINT="https://api.telegram.org"

# Set to true when connecting to a local telegram-bot-api server instance.
# Allows HTTP endpoints on localhost/127.0.0.1 and extended file size boundaries.
WHATSGRAM_TELEGRAM_LOCAL_API=false

# ------------------------------------------------------------------------------
# WhatsApp Adapter Configuration
# ------------------------------------------------------------------------------
# Initial pairing mechanism: 'qr' (QR code scan) or 'code' (phone pairing code).
# When using 'code', the WHATSGRAM_WHATSAPP_PHONE setting below must be supplied.
WHATSGRAM_WHATSAPP_PAIRING_MODE=qr

# Phone number in international format without '+' or spaces (e.g. 15551234567).
# Required when pairing_mode is 'code'; optional for 'qr'.
WHATSGRAM_WHATSAPP_PHONE=""

# History synchronization policy upon initial device link.
# Allowed values: 'none' (skip past messages) or 'recent' (fetch recent history).
WHATSGRAM_WHATSAPP_HISTORY_POLICY=none

# ------------------------------------------------------------------------------
# Database & Storage Configuration
# ------------------------------------------------------------------------------
# Filesystem path to SQLite database storing session keys and bridge mappings.
# Parent directories will be automatically created with 0700 permissions.
# Database, WAL, and SHM files are maintained with 0600 permissions.
WHATSGRAM_DATABASE_PATH=data/whatsgram.db

# Maximum wait duration for acquiring SQLite locks under concurrent load.
# Allowed range: 1ms to 1m. Default: 5s.
WHATSGRAM_DATABASE_BUSY_TIMEOUT=5s

# ------------------------------------------------------------------------------
# Media & Transcoding Pipeline Configuration
# ------------------------------------------------------------------------------
# Scratch directory for temporary media spooling and transcoding.
# If left empty, the OS default temp directory (os.TempDir()) is used.
WHATSGRAM_MEDIA_TEMP_DIR=""

# Path or name of the FFmpeg binary executable.
WHATSGRAM_MEDIA_FFMPEG=ffmpeg

# Maximum media file size in bytes accepted for processing (1 byte to 10 GiB).
# Default: 52428800 (50 MiB).
WHATSGRAM_MEDIA_MAX_BYTES=52428800

# Maximum allowable media duration (e.g. voice notes, audio, video).
# Allowed range: > 0 to 24h. Default: 10m.
WHATSGRAM_MEDIA_MAX_DURATION=10m

# Command timeout for individual FFmpeg transcoding operations.
WHATSGRAM_MEDIA_TIMEOUT=2m

# Maximum number of concurrent media transcoding worker goroutines (1 to 64).
WHATSGRAM_MEDIA_WORKERS=2

# ------------------------------------------------------------------------------
# Runtime, Retry, & Lifecycle Configuration
# ------------------------------------------------------------------------------
# Internal channel queue capacity for inbound events (1 to 65536).
WHATSGRAM_RUNTIME_QUEUE_CAPACITY=256

# Default timeout applied to atomic coordinator operations and store claims.
# Allowed range: > 0 to 24h. Default: 30s.
WHATSGRAM_RUNTIME_OPERATION_TIMEOUT=30s

# Maximum retry attempts for transient delivery failures (1 to 100).
WHATSGRAM_RUNTIME_MAX_ATTEMPTS=5

# Initial base delay for exponential backoff on transient errors.
WHATSGRAM_RUNTIME_RETRY_BASE=1s

# Maximum delay cap for exponential backoff on transient errors.
WHATSGRAM_RUNTIME_RETRY_MAX=1m

# Grace period allowed for runners to complete ongoing tasks on SIGINT/SIGTERM.
WHATSGRAM_RUNTIME_SHUTDOWN_TIMEOUT=15s

# ------------------------------------------------------------------------------
# Docker Deployment Configuration (Optional)
# ------------------------------------------------------------------------------
# Container image override for docker compose.
# WHATSGRAM_IMAGE=ghcr.io/darkydtm/whatsgram:latest
