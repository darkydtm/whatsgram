# PostgreSQL
POSTGRES_DB=whatsgram
POSTGRES_USER=whatsgram
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgres://whatsgram:replace-with-a-strong-password@postgres:5432/whatsgram?sslmode=disable

# Application
HTTP_ADDR=:8080
IMAGE=whatsgram:local

# WhatsApp Web
# On first start, scan the QR code printed in the application logs.

# Telegram Bot API
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-string
TELEGRAM_GROUP_ID=-1001234567890
TELEGRAM_SYSTEM_THREAD_ID=1
TELEGRAM_ALLOWED_USER_IDS=123456789
